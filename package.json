{
  "name": "projectm",
  "version": "1.0.8",
  "description": "ProjectM: local files, YouTube Music, SoundCloud and Spotify in one player",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win"
  },
  "author": "m",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "music-metadata": "^11.16.1",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "hls.js": "^1.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "productName": "ProjectM",
  "private": true,
  "build": {
    "appId": "com.projectm.app",
    "productName": "ProjectM",
    "copyright": "Personal use",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ProjectM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ProjectM",
      "uninstallDisplayName": "ProjectM",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
